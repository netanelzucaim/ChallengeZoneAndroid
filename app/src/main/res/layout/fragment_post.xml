<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="#FFFFFF"
    android:elevation="4dp"
    android:padding="8dp">

    <!-- Challenge Logo -->
    <ImageView
        android:id="@+id/ivChallengeLogo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/challenges_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Challenge Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toEndOf="@id/ivChallengeLogo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvChallengeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Challenge.Zone"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvChallengeTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8 hours ago"
            android:textSize="12sp"
            android:textColor="#808080" />
    </LinearLayout>

    <!-- Challenge Description -->
    <TextView
        android:id="@+id/tvChallengeDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="The First Challenge For Today: Hold a plank position for 2 minutes"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/ivChallengeLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Likes and Comments -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvChallengeDescription"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/ivLikeIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/like_icon" />

        <TextView
            android:id="@+id/tvLikes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="18K likes"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/ivCommentIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/comment_icon" />

        <TextView
            android:id="@+id/tvComments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="542 comments"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
